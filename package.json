{
  "name": "rezi-angular-basic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Angular Basic reference for the Dezrez partner contract.",
  "license": "MIT",
  "engines": { "node": "^22.22.3 || ^24.15.0 || >=26.0.0", "npm": ">=10" },
  "scripts": {
    "dev": "ng serve --host 127.0.0.1 --port 4200",
    "start": "node scripts/serve.mjs",
    "build": "ng build --configuration production",
    "test": "ng test --watch=false",
    "check:welcome": "ng test --watch=false --include=src/app/app.component.spec.ts",
    "validate": "node scripts/validate.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@types/node": "22.20.5",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
